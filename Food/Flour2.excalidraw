    {
      "id": "2se9kQDdrs4paEpHQvQ-4",
      "type": "text",
      "x": -153.5568553478313,
      "y": -1551.8396455374798,
      "width": 921.8800048828125,
      "height": 23,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#2f9e44",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4e",
      "roundness": null,
      "seed": 1959347130,
      "version": 20,
      "versionNonce": 617430502,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782892830969,
      "link": null,
      "locked": false,
      "text": "油脂：油会在蛋白质周围形成油膜，阻碍二硫键连接，所以做饼干要“搓油”来断筋，做面包则要后放油。",
      "fontSize": 20,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "油脂：油会在蛋白质周围形成油膜，阻碍二硫键连接，所以做饼干要“搓油”来断筋，做面包则要后放油。",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "B2cbX9Rf38GhOjwo_s1qp",
      "type": "text",
      "x": -152.3589407477532,
      "y": -1497.9367602262637,
      "width": 810,
      "height": 23,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#2f9e44",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4f",
      "roundness": null,
      "seed": 1106975078,
      "version": 11,
      "versionNonce": 978602042,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782892841896,
      "link": null,
      "locked": false,
      "text": "静置（醒面）：揉好的面团静置一会儿，面筋会自然松弛，延展性更好，更容易擀开不回缩。",
      "fontSize": 20,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "静置（醒面）：揉好的面团静置一会儿，面筋会自然松弛，延展性更好，更容易擀开不回缩。",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "W-0maL3eXjnDcDfvr5_pG",
      "type": "text",
      "x": -151.5729067102102,
      "y": -1603.0126922039021,
      "width": 338.49993896484375,
      "height": 23,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#2f9e44",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4o",
      "roundness": null,
      "seed": 614995450,
      "version": 164,
      "versionNonce": 240459578,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782893150427,
      "link": null,
      "locked": false,
      "text": "全麦的小颗粒 也会阻止gluten的连续性",
      "fontSize": 20,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "全麦的小颗粒 也会阻止gluten的连续性",
      "autoResize": true,
      "lineHeight": 1.15
    },
