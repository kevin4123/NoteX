      "type": "text",
      "x": -7032.7635836686295,
      "y": 7112.044660841633,
      "width": 2915.353515625,
      "height": 194.5905343191973,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
