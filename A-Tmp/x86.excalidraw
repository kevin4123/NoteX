    {
      "id": "GitUDuE67DOJbCFMVrsIE",
      "type": "text",
      "x": -1904.9604987479988,
      "y": -1044.9646859702448,
      "width": 55.73429870605469,
      "height": 14.941537601111426,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#846358",
