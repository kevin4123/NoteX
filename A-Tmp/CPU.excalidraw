      "type": "text",
      "x": 5020.241501233914,
      "y": 1374.3275005306891,
      "width": 1453.187744140625,
      "height": 125.01474097918492,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
