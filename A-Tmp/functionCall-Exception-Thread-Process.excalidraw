      "type": "text",
      "x": -2080.3760188761316,
      "y": -1939.0058671376378,
      "width": 869.9728090693408,
      "height": 65.50189984394763,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
