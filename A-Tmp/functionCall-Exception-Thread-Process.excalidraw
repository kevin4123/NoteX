      "boundElements": [],
      "updated": 1766605707017,
      "link": null,
      "locked": false,
      "text": "由 调用约定 保证正常运行",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "由 调用约定 保证正常运行",
