    {
      "id": "E1STmy7Sw3onwbYUqgASX",
      "type": "text",
      "x": 7823.073794511374,
      "y": -558.0572892637033,
      "width": 659.4114990234375,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#846358",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAd",
      "roundness": null,
      "seed": 390842967,
      "version": 31,
      "versionNonce": 753419929,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774364619264,
      "link": null,
      "locked": false,
      "text": "factorial(3)\n └──→ factorial(2)\n       └──→ factorial(1)\n             └── 返回 1\n       ←── 拿到1，算 2×1=2，返回 2\n ←── 拿到2，算 3×2=6，返回 6",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "factorial(3)\n └──→ factorial(2)\n       └──→ factorial(1)\n             └── 返回 1\n       ←── 拿到1，算 2×1=2，返回 2\n ←── 拿到2，算 3×2=6，返回 6",
      "autoResize": true,
      "lineHeight": 1.25
