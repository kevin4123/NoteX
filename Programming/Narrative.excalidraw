      "isDeleted": false,
      "boundElements": [],
      "updated": 1774402340244,
      "link": null,
      "locked": false,
      "text": "这样一个小块里面包含了所有可能的结构",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "这样一个小块里面包含了所有可能的结构",
