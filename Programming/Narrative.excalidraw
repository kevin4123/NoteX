    {
      "id": "wva_1WqST3lT9kPRHawGt",
      "type": "text",
      "x": 5341.409170778982,
      "y": 1655.427607506284,
      "width": 659.4114990234375,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#846358",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3X",
      "roundness": null,
      "seed": 507192735,
      "version": 61,
      "versionNonce": 1207751569,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774402340255,
      "link": null,
      "locked": false,
      "text": "factorial(3)\n └──→ factorial(2)\n       └──→ factorial(1)\n             └── 返回 1\n       ←── 拿到1，算 2×1=2，返回 2\n ←── 拿到2，算 3×2=6，返回 6",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "factorial(3)\n └──→ factorial(2)\n       └──→ factorial(1)\n             └── 返回 1\n       ←── 拿到1，算 2×1=2，返回 2\n ←── 拿到2，算 3×2=6，返回 6",
      "autoResize": true,
      "lineHeight": 1.25
    },
