      "locked": false,
      "text": "官方手册",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "官方手册",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mUWDNLK97UKId2xHxQZIc",
      "type": "text",
      "x": 1002.6599694833842,
      "y": 24.21141250530558,
      "width": 666.509765625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": null,
      "seed": 1987186579,
      "version": 68,
      "versionNonce": 1500638547,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770870971306,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────┐\n│      你写的应用程序 / 内核          │\n├─────────────────────────────────────┤\n│  VME  │  虚拟内存（地址空间隔离）   │  ← 有了它，才是“现代OS”\n├─────────────────────────────────────┤\n│  CTE  │  中断/异常/上下文切换       │  ← 有了它，才能“多任务”\n├─────────────────────────────────────┤\n│  IOE  │  键盘/屏幕/时钟/串口        │  ← 有了它，才能“交互”\n├─────────────────────────────────────┤\n│  TRM  │  main/heap/putch/halt       │  ← 最底层的“计算”\n└─────────────────────────────────────┘\n         ↓ 每一层都依赖下层\n    AbstractMachine（AM）规约\n         ↓ 具体实现\n    NEMU / QEMU / 真实硬件",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────┐\n│      你写的应用程序 / 内核          │\n├─────────────────────────────────────┤\n│  VME  │  虚拟内存（地址空间隔离）   │  ← 有了它，才是“现代OS”\n├─────────────────────────────────────┤\n│  CTE  │  中断/异常/上下文切换       │  ← 有了它，才能“多任务”\n├─────────────────────────────────────┤\n│  IOE  │  键盘/屏幕/时钟/串口        │  ← 有了它，才能“交互”\n├─────────────────────────────────────┤\n│  TRM  │  main/heap/putch/halt       │  ← 最底层的“计算”\n└─────────────────────────────────────┘\n         ↓ 每一层都依赖下层\n    AbstractMachine（AM）规约\n         ↓ 具体实现\n    NEMU / QEMU / 真实硬件",
      "autoResize": true,
      "lineHeight": 1.25
    },
