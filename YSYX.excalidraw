    },
    {
      "id": "SQXyUxI4d9Mb3PJsYnUJE",
      "type": "text",
      "x": 2592.0788674618557,
      "y": -203.54208496510125,
      "width": 623.509765625,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 666896307,
      "version": 160,
      "versionNonce": 1717586931,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770910376481,
      "link": null,
      "locked": false,
      "text": "cpu_exec(-1)\n    │\n    ├─ 状态检查（已结束？）\n    │\n    ├─ 开始计时\n    │\n    ├─ execute(n)\n    │    └─ 循环：\n    │         ├─ exec_once()\n    │         │    ├─ isa_exec_once()  // 取指译码执行\n    │         │    └─ ITRACE日志        // 记录指令\n    │         │\n    │         ├─ 差分测试              // 和参考模拟器对比\n    │         ├─ 指令计数+1\n    │         └─ 状态异常? → break\n    │\n    ├─ 结束计时\n    │\n    └─ 打印结果：\n         GOOD TRAP ✅ / BAD TRAP ❌ / ABORT ❌",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cpu_exec(-1)\n    │\n    ├─ 状态检查（已结束？）\n    │\n    ├─ 开始计时\n    │\n    ├─ execute(n)\n    │    └─ 循环：\n    │         ├─ exec_once()\n    │         │    ├─ isa_exec_once()  // 取指译码执行\n    │         │    └─ ITRACE日志        // 记录指令\n    │         │\n    │         ├─ 差分测试              // 和参考模拟器对比\n    │         ├─ 指令计数+1\n    │         └─ 状态异常? → break\n    │\n    ├─ 结束计时\n    │\n    └─ 打印结果：\n         GOOD TRAP ✅ / BAD TRAP ❌ / ABORT ❌",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_I7soW2kK1NN4hk1jmqr4",
      "type": "text",
      "x": 3344.428452644335,
      "y": -165.28086719249143,
      "width": 595,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 1143053725,
      "version": 211,
      "versionNonce": 1160985395,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770911724405,
      "link": null,
      "locked": false,
      "text": "世界            开始                      结束\nLinux           kernel → _start          exit syscall\n裸机            reset vector              死循环 / trap\nNEMU            PC初始化                  nemu_trap",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "世界            开始                      结束\nLinux           kernel → _start          exit syscall\n裸机            reset vector              死循环 / trap\nNEMU            PC初始化                  nemu_trap",
      "autoResize": true,
      "lineHeight": 1.25
    },
