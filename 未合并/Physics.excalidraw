      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606400964,
      "link": null,
      "locked": false,
      "text": "分子也能“看见”，但分辨率更难",
      "fontSize": 13.860431436510803,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "分子也能“看见”，但分辨率更难",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4yCK8-XB4H5aVDC6aGAwZ",
      "type": "text",
      "x": -250.78827301830603,
      "y": 1430.8681834332967,
      "width": 304.99877684094827,
      "height": 34.651078591277006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1857463446,
      "version": 173,
      "versionNonce": 2028214218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606400964,
      "link": null,
      "locked": false,
      "text": "用改进的 非接触式原子力显微镜（nc-AFM），可\n以看到整个分子的化学键结构，",
      "fontSize": 13.860431436510803,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "用改进的 非接触式原子力显微镜（nc-AFM），可以看到整个分子的化学键结构，",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "yRlK2aVdIAiM90eivXti8",
      "type": "text",
      "x": -250.78827301830603,
      "y": 1467.5636009883847,
      "width": 124.7398681640625,
      "height": 17.325539295638503,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 149004758,
      "version": 180,
      "versionNonce": 685936266,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606400964,
      "link": null,
      "locked": false,
      "text": "比如苯环、碳链等。",
      "fontSize": 13.860431436510803,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "比如苯环、碳链等。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IWpYkWsDrC8EUK1jL5R0E",
      "type": "text",
      "x": -250.78827301830603,
      "y": 1486.9334792478344,
      "width": 303.2246221596821,
      "height": 34.651078591277006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
