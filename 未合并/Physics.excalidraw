    {
      "id": "dPJecWrbYFYf2t-8LWjfo",
      "type": "text",
      "x": -250.78827301830603,
      "y": 1411.4983051738473,
      "width": 191.8221893310547,
      "height": 17.325539295638503,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
