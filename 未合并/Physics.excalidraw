      "index": "aK",
      "roundness": null,
      "seed": 926611222,
      "version": 202,
      "versionNonce": 660876618,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606400964,
      "link": null,
      "locked": false,
      "text": "不过这种成像其实是靠探针“感应”出力的分布，再\n转换成图像，不是直接光学成像。",
      "fontSize": 13.860431436510803,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "不过这种成像其实是靠探针“感应”出力的分布，再转换成图像，不是直接光学成像。",
      "autoResize": false,
      "lineHeight": 1.25
    },
