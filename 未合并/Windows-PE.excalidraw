      "seed": 1347527092,
      "version": 118,
      "versionNonce": 1943885364,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606075790,
      "link": null,
      "locked": false,
      "text": "此时，消息队列中只能接收 模态对话框 的消息\n其他窗口被禁用，消息无法传递进来",
      "fontSize": 8,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "此时，消息队列中只能接收 模态对话框 的消息\n其他窗口被禁用，消息无法传递进来",
      "autoResize": true,
      "lineHeight": 1.25
    },
