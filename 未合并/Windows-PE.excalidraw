    {
      "id": "nRR9D8-CeYMUrbWfGW2XH",
      "type": "text",
      "x": -1760.8897502093864,
      "y": 1516.959336459683,
      "width": 434.73583984375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eaddd7",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCy",
      "roundness": null,
      "seed": 418628788,
      "version": 337,
      "versionNonce": 800878516,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606075790,
      "link": null,
      "locked": false,
      "text": "windows先发送WM_NCHITTEST(包含鼠标点击的 屏幕坐标),\n返回值告诉windows点击了窗口的哪个区域",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "windows先发送WM_NCHITTEST(包含鼠标点击的 屏幕坐标),\n返回值告诉windows点击了窗口的哪个区域",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HocrbWfhjtLjQ6P0sSu6K",
      "type": "text",
      "x": -1760.8897503009453,
      "y": 1564.6743976626503,
      "width": 382.7359619140625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eaddd7",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCz",
      "roundness": null,
      "seed": 1963003444,
      "version": 275,
      "versionNonce": 206214540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606075790,
      "link": null,
      "locked": false,
      "text": "例：返回HTCLIENT(客户区)\n        1.系统会递归地检查目标窗口的所有子窗口和控件\n        2.将 屏幕坐标 转换为目标窗口的 客户区坐标\n        3.生成具体的 鼠标消息 给窗口(或 子窗口)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "例：返回HTCLIENT(客户区)\n        1.系统会递归地检查目标窗口的所有子窗口和控件\n        2.将 屏幕坐标 转换为目标窗口的 客户区坐标\n        3.生成具体的 鼠标消息 给窗口(或 子窗口)",
      "autoResize": true,
      "lineHeight": 1.25
    },
