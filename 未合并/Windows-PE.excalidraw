    {
      "id": "WoY_T-aFtPLwNxczebNH8",
      "type": "text",
      "x": -1069.6325658849178,
      "y": 319.2909834708006,
      "width": 166.39999389648438,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#e9ecef",
