      "updated": 1766605849029,
      "link": null,
      "locked": false,
      "text": "优势2：方便扩展功能，比如继承",
      "fontSize": 49.59699739147835,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "优势2：方便扩展功能，比如继承",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "groNWMMycDkNyP2Sih4ox",
      "type": "text",
      "x": 548.9622456614727,
      "y": -4347.430260526669,
      "width": 2694.572021484375,
      "height": 61.99624673934793,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "solid",
