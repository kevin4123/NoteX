    {
      "id": "xRWLfdQIKUFiNWw5KN8E2",
      "type": "text",
      "x": 63.22109407504621,
      "y": -219.24844723214272,
      "width": 2618,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 87126942,
      "version": 106,
      "versionNonce": 513225374,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774350562265,
      "link": null,
      "locked": false,
      "text": "Reasoning from First Principles: This involves identifying the fundamental truths and building a new solution based on those truths.\n\nLogic: \"What do we know is true? A vehicle must transport a person from point A to point B safely. The most efficient way to generate motion is through an electric motor. The most stable structure can be made from aluminum or composites.\"\n\nOutcome: You create the modern electric vehicle, unburdened by the \"necessity\" of a gas engine.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reasoning from First Principles: This involves identifying the fundamental truths and building a new solution based on those truths.\n\nLogic: \"What do we know is true? A vehicle must transport a person from point A to point B safely. The most efficient way to generate motion is through an electric motor. The most stable structure can be made from aluminum or composites.\"\n\nOutcome: You create the modern electric vehicle, unburdened by the \"necessity\" of a gas engine.",
      "autoResize": true,
      "lineHeight": 1.25
    },
