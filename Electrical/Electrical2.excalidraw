      "index": "b0d",
      "roundness": null,
      "seed": 944899698,
      "version": 46,
      "versionNonce": 792378670,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770025865489,
      "link": null,
      "locked": false,
      "text": "突然有一天下面这个实验发现这两个东西可以关联起来",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "突然有一天下面这个实验发现这两个东西可以关联起来",
