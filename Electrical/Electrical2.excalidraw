      "isDeleted": false,
      "boundElements": null,
      "updated": 1770025830136,
      "link": null,
      "locked": false,
      "text": "人们认为这是两种东西",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "人们认为这是两种东西",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VkZ9JJpECnO7iylpp8ug0",
      "type": "text",
      "x": 1263.1549150955154,
      "y": 190.84043565605737,
      "width": 480,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
