      "isDeleted": false,
      "boundElements": [],
      "updated": 1769584056658,
      "link": null,
      "locked": false,
      "text": "❌ 非图灵完备的系统",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "❌ 非图灵完备的系统",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "dTwVuD0Cb49-LWhxDNd26",
      "type": "text",
      "x": 371.8759497319637,
      "y": -246.5901210826346,
      "width": 172.68092346191406,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
