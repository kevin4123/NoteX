      "isDeleted": false,
      "boundElements": [],
      "updated": 1769584056658,
      "link": null,
      "locked": false,
      "text": "✅ 图灵完备的系统",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ 图灵完备的系统",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "QBitdFFW73LtGrw1szkL6",
      "type": "text",
      "x": 371.87595003819786,
      "y": -183.58939667013829,
      "width": 595.599365234375,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1A",
      "roundness": null,
      "seed": 143559267,
      "version": 152,
      "versionNonce": 351751459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769584056658,
      "link": null,
      "locked": false,
      "text": "图灵机：① 条件分支（Conditional branching）\n                ② 重复执行 / 循环 / 递归（Ability to iterate or recurse）\n                ③ 可无限增长的存储（Unlimited / unbounded memory）",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "图灵机：① 条件分支（Conditional branching）\n                ② 重复执行 / 循环 / 递归（Ability to iterate or recurse）\n                ③ 可无限增长的存储（Unlimited / unbounded memory）",
      "autoResize": true,
      "lineHeight": 1.35
    },
