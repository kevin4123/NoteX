      "isDeleted": false,
      "boundElements": null,
      "updated": 1769472731719,
      "link": null,
      "locked": false,
      "text": "形式系统无法自动解决一切问题",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "形式系统无法自动解决一切问题",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "sJZQXbmFfBdYs67sBDtCM",
      "type": "text",
      "x": 1035.7120371029914,
      "y": -1329.9776930774249,
      "width": 256.77972412109375,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
