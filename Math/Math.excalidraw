      "roundness": null,
      "seed": 1479365260,
      "version": 216,
      "versionNonce": 1106627636,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769472748624,
      "link": null,
      "locked": false,
      "text": "形式化系统不能通过推理验证所有问题的真假",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "形式化系统不能通过推理验证所有问题的真假",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "FYt9s_RhEpAj3Xv-rdsUU",
      "type": "text",
      "x": 521.5819407708153,
      "y": -1297.8456769047175,
      "width": 420,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b53",
      "roundness": null,
      "seed": 83132340,
      "version": 230,
      "versionNonce": 1717088396,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769472736926,
      "link": null,
      "locked": false,
      "text": "数学上不存在一个完美的系统可以解答任何问题",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "数学上不存在一个完美的系统可以解答任何问题",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "Au9ibldhofmzRDZ4yhWU5",
      "type": "text",
      "x": 518.1642728232987,
      "y": -1266.976969333037,
      "width": 460,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b54",
      "roundness": null,
      "seed": 351209868,
      "version": 506,
      "versionNonce": 1282635956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769472776473,
      "link": null,
      "locked": false,
      "text": "也就是说总有真命题在此系统下没有办法自动证明的",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "也就是说总有真命题在此系统下没有办法自动证明的",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "nk2lILrHuqQoP1dl_cUjI",
      "type": "text",
      "x": 1024.1018990174489,
      "y": -1392.9784172428701,
