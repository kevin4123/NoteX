      "lineHeight": 1.35
    },
    {
      "id": "AdUkS2CUX0O2ZqP4WbU7R",
      "type": "text",
      "x": 518.1642728511652,
      "y": -1329.977692543963,
      "width": 400,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
