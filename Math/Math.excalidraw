      "seed": 1780923148,
      "version": 203,
      "versionNonce": 1173013004,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769471205024,
      "link": null,
      "locked": false,
      "text": "有限状态\n   ↓\n非图灵完备\n   ↓\n可判定\n   ↓\nSAT / SMT / Model Checking\n\n无限状态\n   ↓\n图灵完备\n   ↓\n不可判定\n   ↓\n定理证明 / 人工参与",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "有限状态\n   ↓\n非图灵完备\n   ↓\n可判定\n   ↓\nSAT / SMT / Model Checking\n\n无限状态\n   ↓\n图灵完备\n   ↓\n不可判定\n   ↓\n定理证明 / 人工参与",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "EUqAlsgjoh23VxTKk_6iP",
      "type": "text",
      "x": 1397.000993396768,
      "y": -1329.977693208088,
