      "versionNonce": 713477357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771840764485,
      "link": null,
      "locked": false,
      "text": "API 是源代码层面的接口，确保源代码可移植（写一次，重新编译到处跑）。",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API 是源代码层面的接口，确保源代码可移植（写一次，重新编译到处跑）。",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "ZA5Q02Jjq7tQbabbJT2zj",
      "type": "text",
      "x": 424.26729731588824,
      "y": -2266.4164700419838,
      "width": 636.875,
      "height": 24,
