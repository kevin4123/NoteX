    {
      "id": "wn4YYIB6xqiRIH87C2UAG",
      "type": "text",
      "x": -700.328589684112,
      "y": -2241.729479041984,
      "width": 676.875,
      "height": 24,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
