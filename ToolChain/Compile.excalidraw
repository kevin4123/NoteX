      "seed": 496543747,
      "version": 126,
      "versionNonce": 1250749005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771840380126,
      "link": null,
      "locked": false,
      "text": "API 是给人（开发者） 看的，通过调用 API，\n开发者可以使用现成的功能，而无需了解内部实现",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API 是给人（开发者） 看的，通过调用 API，\n开发者可以使用现成的功能，而无需了解内部实现",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "zWa0x3wzqMu7aTyMlIG9Q",
