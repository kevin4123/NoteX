    {
      "id": "wE8du477SBZtPO1tZywWu",
      "type": "text",
      "x": -91.06270318483803,
      "y": 1876.0823981279736,
      "width": 144.22000122070312,
      "height": 90.14621075648917,
      "angle": 0,
      "strokeColor": "#1e1e1e",
