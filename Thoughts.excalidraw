      "version": 77,
      "versionNonce": 373196024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767902128900,
      "link": null,
      "locked": false,
      "text": "资源的开采效率更高了，但是地球上的资源总量并没有改变",
      "fontSize": 40.44445800781252,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "资源的开采效率更高了，但是地球上的资源总量并没有改变",
      "autoResize": true,
      "lineHeight": 1.25
    }
