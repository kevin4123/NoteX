      "text": "① 人类的视觉是有问题的",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "① 人类的视觉是有问题的",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p2UzyVKZnGzH3eYSTQ-oh",
      "type": "image",
      "x": -1228.574304857779,
