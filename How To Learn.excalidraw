    {
      "id": "A9IiLvPC2uHkTG051oRWr",
      "type": "text",
      "x": 4316.181947150681,
      "y": 1414.5085766654815,
      "width": 580,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
