    {
      "id": "eHnQw3RMki7Gk7oKVMEGH",
      "type": "text",
      "x": 5320.772657960702,
      "y": -1057.0210599929653,
      "width": 240,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
