      "width": 594.93994140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#ff8787",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8I",
      "roundness": null,
      "seed": 2079478195,
      "version": 249,
      "versionNonce": 852227667,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606366508,
      "link": null,
      "locked": false,
      "text": "他们都可以看成一个小盒子里面有一个状态集，还有input和output",
      "fontSize": 20,
