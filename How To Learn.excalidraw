      "versionNonce": 1421490483,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606366504,
      "link": null,
      "locked": false,
      "text": "通过抽象降低思考的复杂度，\n才能提高设计的复杂度",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "通过抽象降低思考的复杂度，\n才能提高设计的复杂度",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q6VnZRMe7S4eiq3yKpuIz",
      "type": "text",
      "x": 5933.041252156538,
      "y": -482.3402773085252,
      "width": 364.41998291015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3y",
      "roundness": null,
      "seed": 909051443,
      "version": 341,
      "versionNonce": 1042455251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606366504,
      "link": null,
      "locked": false,
      "text": "就像人类不可能汇编语言开发出AI模型，\n你只能用高级语言python开发ai模型",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "就像人类不可能汇编语言开发出AI模型，\n你只能用高级语言python开发ai模型",
      "autoResize": true,
      "lineHeight": 1.25
    },
