    {
      "id": "NWplvJnTlGGE4G-jiZnD9",
      "type": "text",
      "x": 5603.170993046291,
      "y": -649.0115441009486,
      "width": 167.6399688720703,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "dotted",
