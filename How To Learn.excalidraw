    {
      "id": "cADpf3E4d65jnfzBMPBhx",
      "type": "text",
      "x": 5933.041252679544,
      "y": -1023.8294680423883,
      "width": 260,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
