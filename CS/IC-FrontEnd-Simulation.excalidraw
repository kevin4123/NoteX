      "seed": 1925974898,
      "version": 1201,
      "versionNonce": 33719982,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766987359868,
      "link": null,
      "locked": false,
      "text": "I先变换,先计算组合逻辑\n使波形简单易懂,图像上确保了\nclk前,I已经稳定",
      "fontSize": 10.491196906254894,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I先变换,先计算组合逻辑\n使波形简单易懂,图像上确保了\nclk前,I已经稳定",
      "autoResize": true,
      "lineHeight": 1.2
    },
