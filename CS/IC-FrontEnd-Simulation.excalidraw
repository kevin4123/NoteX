    {
      "id": "owvrrIAjh3GG6iYsBydEE",
      "type": "text",
      "x": 240.30896310279059,
      "y": -3339.3676437595354,
      "width": 386.875,
      "height": 72,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
