      "seed": 1824339647,
      "version": 198,
      "versionNonce": 246801777,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775032176817,
      "link": null,
      "locked": false,
      "text": "app: $(OBJS)\n        $(LD) -o app $(OBJS)\n\nOBJS = $(SRCS:%.c=$(OBJ_DIR)/%.o) $(CXXSRC:%.cc=$(OBJ_DIR)/%.o)\n\n# Compilation patterns\n$(OBJ_DIR)/%.o: %.c\n        @echo + CC $<\n        @mkdir -p $(dir $@)\n        @$(CC) $(CFLAGS) -c -o $@ $<\n        @$(CC) $(CFLAGS) -E -o $@.i $<\n        $(call call_fixdep, $(@:.o=.d), $@)\n\n$(OBJ_DIR)/%.o: %.cc\n        @echo + CXX $<\n        @mkdir -p $(dir $@)\n        @$(CXX) $(CFLAGS) $(CXXFLAGS) -c -o $@ $<\n        $(call call_fixdep, $(@:.o=.d), $@)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "app: $(OBJS)\n        $(LD) -o app $(OBJS)\n\nOBJS = $(SRCS:%.c=$(OBJ_DIR)/%.o) $(CXXSRC:%.cc=$(OBJ_DIR)/%.o)\n\n# Compilation patterns\n$(OBJ_DIR)/%.o: %.c\n        @echo + CC $<\n        @mkdir -p $(dir $@)\n        @$(CC) $(CFLAGS) -c -o $@ $<\n        @$(CC) $(CFLAGS) -E -o $@.i $<\n        $(call call_fixdep, $(@:.o=.d), $@)\n\n$(OBJ_DIR)/%.o: %.cc\n        @echo + CXX $<\n        @mkdir -p $(dir $@)\n        @$(CXX) $(CFLAGS) $(CXXFLAGS) -c -o $@ $<\n        $(call call_fixdep, $(@:.o=.d), $@)",
      "autoResize": true,
      "lineHeight": 1.25
    },
