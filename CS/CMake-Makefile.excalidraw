    {
      "id": "EG4Qc4T_-u65OCPpKsTAg",
      "type": "text",
      "x": -3155.3312450110284,
      "y": 3902.7681187184385,
      "width": 693,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPM",
