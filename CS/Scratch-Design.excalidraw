    {
      "id": "6J0ayc0H5x_-X5J-EYsiC",
      "type": "text",
      "x": 396.22482172347435,
      "y": -3079.905440322999,
      "width": 384.73617905663406,
      "height": 36.9938633708302,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
