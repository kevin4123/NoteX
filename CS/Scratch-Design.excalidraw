      "roundness": null,
      "seed": 376603285,
      "version": 50,
      "versionNonce": 1525822491,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767050478661,
      "link": null,
      "locked": false,
      "text": "这是最完美的，任何一个设计理念最好都能边搭建边设计边验证",
