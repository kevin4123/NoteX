    {
      "id": "6J0ayc0H5x_-X5J-EYsiC",
      "type": "text",
      "x": 400.3998797234743,
      "y": -3078.861675322999,
      "width": 384.73617905663406,
      "height": 36.9938633708302,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
