      "versionNonce": 1277326661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774534958076,
      "link": null,
      "locked": false,
      "text": "但是如果想要某一种特定的系统或者规则，这个需要人的逻辑去干预这个设计",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "但是如果想要某一种特定的系统或者规则，这个需要人的逻辑去干预这个设计",
      "autoResize": true,
      "lineHeight": 1.25
    },
