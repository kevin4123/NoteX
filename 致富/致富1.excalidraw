      "isDeleted": false,
      "boundElements": [],
      "updated": 1771607120845,
      "link": null,
      "locked": false,
      "text": "开发工具/框架：PyTorch、TensorFlow(它们基于 CUDA 封装了更简单的命令)。",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "开发工具/框架：PyTorch、TensorFlow(它们基于 CUDA 封装了更简单的命令)。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
