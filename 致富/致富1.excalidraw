      "seed": 1099573967,
      "version": 315,
      "versionNonce": 1386899297,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771607120845,
      "link": null,
      "locked": false,
      "text": "马斯克",
      "fontSize": 20,
      "fontFamily": 8,
