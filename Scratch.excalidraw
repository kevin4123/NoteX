      "index": "b7c",
      "roundness": null,
      "seed": 575000219,
      "version": 75,
      "versionNonce": 176348604,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767422165019,
      "link": null,
      "locked": false,
      "text": "然后剩下的就是如何把图像或者设计用有序的代码结构展现",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "然后剩下的就是如何把图像或者设计用有序的代码结构展现",
