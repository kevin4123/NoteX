    {
      "id": "u7vN4UKBj1uAyRquuQ3xx",
      "type": "text",
      "x": 905.9331831997625,
      "y": 899.8113308253683,
      "width": 679.699951171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1571417644,
      "version": 158,
      "versionNonce": 313075884,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771702668234,
      "link": null,
      "locked": false,
      "text": "负责解决：为了确保在嘈杂中听清，你不能只喊一遍。你要设计一套说法，\n            比如把“9527”编码成“九五两拐七”，或者喊三遍取多数（重复码）\n            ，或者更高级的方式加一些校验词（纠错码），让对方即便漏听了\n            一两个字，也能猜出原意。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "负责解决：为了确保在嘈杂中听清，你不能只喊一遍。你要设计一套说法，\n            比如把“9527”编码成“九五两拐七”，或者喊三遍取多数（重复码）\n            ，或者更高级的方式加一些校验词（纠错码），让对方即便漏听了\n            一两个字，也能猜出原意。",
      "autoResize": true,
      "lineHeight": 1.25
    },
