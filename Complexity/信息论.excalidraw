      "version": 115,
      "versionNonce": 1205450132,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771702925048,
      "link": null,
      "locked": false,
      "text": "研究的是方法层的实现（如何用具体算法逼近极限、纠正错误）。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "研究的是方法层的实现（如何用具体算法逼近极限、纠正错误）。",
      "autoResize": false,
      "lineHeight": 1.25
    },
