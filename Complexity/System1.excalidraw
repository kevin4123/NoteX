    {
      "id": "vbnt7H7cuXnp78OyWlmoS",
      "type": "text",
      "x": -570.7493419816578,
      "y": 1257.4519278238977,
      "width": 820,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
