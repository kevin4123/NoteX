    {
      "id": "NCKKD2bNQf42H0Qpoqfm5",
      "type": "text",
      "x": 1052.122364367224,
      "y": 821.0400814107726,
      "width": 515,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 1179207849,
      "version": 225,
      "versionNonce": 690810087,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770022790387,
      "link": null,
      "locked": false,
      "text": "Subsystem S {\n    State      X;     // 内部信息（可跨时间保持）\n    Input      I;     // 来自其他子系统\n    Output     O;     // 发往其他子系统\n    \n    Behavior {\n        X⁺ = f(X, I); // 状态转移\n        O  = g(X, I); // 输出生成\n    }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Subsystem S {\n    State      X;     // 内部信息（可跨时间保持）\n    Input      I;     // 来自其他子系统\n    Output     O;     // 发往其他子系统\n    \n    Behavior {\n        X⁺ = f(X, I); // 状态转移\n        O  = g(X, I); // 输出生成\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
