      "text": "Write-through：CPU 写数据 同时写入 cache 和内存",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write-through：CPU 写数据 同时写入 cache 和内存",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
