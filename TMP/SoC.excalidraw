      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "No write allocate：写缺失时不把行加载到 cache，直接写内存",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No write allocate：写缺失时不把行加载到 cache，直接写内存",
