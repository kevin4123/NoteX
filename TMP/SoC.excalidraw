      "locked": false
    },
    {
      "id": "wFHChe3hGohAzeBasAwjK",
      "type": "text",
      "x": 1322.1747416017056,
      "y": -958.7780010496795,
      "width": 217.875,
      "height": 19.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKU",
      "roundness": null,
      "seed": 826988695,
      "version": 57,
      "versionNonce": 1463612951,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "Non-cacheable（不可缓存）",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-cacheable（不可缓存）",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "ctAfnUpFHfWMGGcbYjLdh",
      "type": "text",
      "x": 1598.0991597910106,
      "y": -958.7780008768318,
      "width": 527.375,
      "height": 19.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKV",
      "roundness": null,
      "seed": 1571925431,
      "version": 86,
      "versionNonce": 176429879,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "CPU 对这块内存 不使用 cache，每次访问都直接去内存（RAM / 外设）",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CPU 对这块内存 不使用 cache，每次访问都直接去内存（RAM / 外设）",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "sTIGTNnJYUOnp84bVPejn",
      "type": "text",
      "x": 1319.8053352945608,
      "y": -901.1136410435724,
      "width": 484.25,
      "height": 19.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKW",
      "roundness": null,
      "seed": 1019272919,
      "version": 77,
      "versionNonce": 1340709975,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "Write-back, write and read allocate（写回 + 写读分配）",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write-back, write and read allocate（写回 + 写读分配）",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "d6MZjDJn8DBONUm6S0SZU",
      "type": "text",
      "x": 1598.8844988447847,
      "y": -874.5739358490332,
      "width": 595.5,
      "height": 19.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKX",
      "roundness": null,
      "seed": 286059511,
      "version": 86,
      "versionNonce": 188873079,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "写回（Write-back）：CPU 写数据先写入 cache，不立即写回内存，内存稍后更新",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "写回（Write-back）：CPU 写数据先写入 cache，不立即写回内存，内存稍后更新",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "GZzvIlm2Pvg0mch1XhNI-",
      "type": "text",
      "x": 1604.3954658447847,
      "y": -844.8771668490331,
      "width": 522.375,
      "height": 19.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKY",
      "roundness": null,
      "seed": 1452954903,
      "version": 99,
      "versionNonce": 835826327,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "Write allocate：CPU 写/读缺失时，会先把整行加载到 cache，再写",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write allocate：CPU 写/读缺失时，会先把整行加载到 cache，再写",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "oT7AoqFJ5l23xD-boI8V4",
      "type": "text",
      "x": 1604.3954658447847,
      "y": -815.1803978490329,
      "width": 395.5,
      "height": 19.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKZ",
      "roundness": null,
      "seed": 350067255,
      "version": 112,
      "versionNonce": 474826679,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766606015530,
      "link": null,
      "locked": false,
      "text": "Read allocate：读缺失时，先加载 cache 行，再读",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read allocate：读缺失时，先加载 cache 行，再读",
      "autoResize": true,
      "lineHeight": 1.2
    },
