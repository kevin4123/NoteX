      "isDeleted": false,
      "boundElements": [],
      "updated": 1771777613523,
      "link": null,
      "locked": false,
      "text": "其他逻辑暂时不清楚",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "其他逻辑暂时不清楚",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0gvXSnDdYWvWrbyVACW9I",
      "type": "text",
      "x": 567.0422761829194,
      "y": -334.8137699141706,
      "width": 740,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
