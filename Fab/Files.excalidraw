      "link": null,
      "locked": false,
      "text": "                 ↑  chip surface / package\n────────────────────────────────────────────────\n\n                RDL   (ROUTING)\n══════════════════════════════════════════════════\n                 │\n                 │  RV (big via)\n                 │\n══════════════════════════════════════════════════\n               T4M2   (thick metal)\n══════════════════════════════════════════════════\n                 │\n                 │  T4V2\n                 │\n══════════════════════════════════════════════════\n               MET5   (H)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA4\n                 │\n══════════════════════════════════════════════════\n               MET4   (V)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA3\n                 │\n══════════════════════════════════════════════════\n               MET3   (H)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA2\n                 │\n══════════════════════════════════════════════════\n               MET2   (V)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA1\n                 │\n══════════════════════════════════════════════════\n               MET1   (H)\n══════════════════════════════════════════════════\n                 │\n                 │  CT (contact)\n                 │\n══════════════════════════════════════════════════\n        POLY / ACT / NP / PP / NWELL\n══════════════════════════════════════════════════\n                 ↓ silicon\n",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                 ↑  chip surface / package\n────────────────────────────────────────────────\n\n                RDL   (ROUTING)\n══════════════════════════════════════════════════\n                 │\n                 │  RV (big via)\n                 │\n══════════════════════════════════════════════════\n               T4M2   (thick metal)\n══════════════════════════════════════════════════\n                 │\n                 │  T4V2\n                 │\n══════════════════════════════════════════════════\n               MET5   (H)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA4\n                 │\n══════════════════════════════════════════════════\n               MET4   (V)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA3\n                 │\n══════════════════════════════════════════════════\n               MET3   (H)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA2\n                 │\n══════════════════════════════════════════════════\n               MET2   (V)\n══════════════════════════════════════════════════\n                 │\n                 │  VIA1\n                 │\n══════════════════════════════════════════════════\n               MET1   (H)\n══════════════════════════════════════════════════\n                 │\n                 │  CT (contact)\n                 │\n══════════════════════════════════════════════════\n        POLY / ACT / NP / PP / NWELL\n══════════════════════════════════════════════════\n                 ↓ silicon\n",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "4XWoPNMrNHRDTURKEbRMU",
